# NexusFlow AI Configuration (template — copy to .env and fill in keys)
APP_NAME="NexusFlow AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Server Settings
HOST="127.0.0.1"
PORT=8000

# SafeGuard fail-safe: auto-REJECT gated actions when no human responds (seconds)
APPROVAL_TIMEOUT_SEC="120"

# LLM planner — Groq (primary) and OpenRouter (fallback), both OpenAI-compatible.
# When both keys are empty the deterministic planner is used ($0 cost).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
