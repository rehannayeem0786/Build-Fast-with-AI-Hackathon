# NexusFlow AI Configuration
APP_NAME="NexusFlow AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Server Settings
HOST="127.0.0.1"
PORT=8000

# SafeGuard fail-safe: auto-REJECT gated actions when no human responds (seconds)
APPROVAL_TIMEOUT_SEC="120"

# Optional LLM API Keys — enables the LLM DAG planner.
# When empty, the deterministic intent-composition planner is used ($0 cost).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_PLANNER_MODEL="gpt-4o"
